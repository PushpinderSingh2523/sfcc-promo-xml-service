# ─────────────────────────────────────────────
# SFCC Promo XML Service — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── AI feature flag ────────────────────────────────────────────────────────────
# true  → use Claude AI for intent parsing (requires valid ANTHROPIC_API_KEY)
# false → use built-in deterministic rule engine (no external calls, no key needed)
FEATURE_FLAG_USE_AI=false

# Anthropic / Claude (only required when FEATURE_FLAG_USE_AI=true)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Security — set a strong random string for production; leave blank for local dev
API_KEY=your-secret-api-key-here

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Logging (error | warn | info | debug)
LOG_LEVEL=info
