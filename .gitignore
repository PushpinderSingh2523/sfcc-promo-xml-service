# ═══════════════════════════════════════════════════════════════════════════════
# SFCC Promo XML Service — .gitignore
# Cross-platform (macOS + Windows)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tgz
.npm

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
coverage/

# ── Environment secrets (NEVER commit) ────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example IS committed — it is the template

# ── Generated runtime state (ephemeral, machine-specific) ─────────────────────
runtime/sessions/
runtime/exports/
runtime/imports/
runtime/traces/
runtime/logs/
output/
logs/

# ── OS artifacts ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Editors / IDEs ────────────────────────────────────────────────────────────
# JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*.orig

# ── Test / coverage artifacts ─────────────────────────────────────────────────
junit.xml
test-results/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
hello.txt
*.tmp
*.temp
