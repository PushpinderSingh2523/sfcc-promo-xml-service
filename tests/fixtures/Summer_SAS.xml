        </custom-attributes>
        <product-promotion-rule>
            <qualifying-products>
                <included-products>
                    <condition-group>
                        <price-condition operator="greater than">
                            <price>0.01</price>
                        </price-condition>
                    </condition-group>
                </included-products>
            </qualifying-products>
            <discounted-products>
                <included-products>
